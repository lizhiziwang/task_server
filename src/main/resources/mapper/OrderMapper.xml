<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zsh.task.mapper.OrderMapper">

    <resultMap id="BaseResultMap" type="com.zsh.task.entity.Order">
        <id column="id" jdbcType="BIGINT" property="id" />
        <id column="commodity_list" jdbcType="VARCHAR" property="commodityList" />
        <id column="state" jdbcType="VARCHAR" property="state" />
        <id column="create_user" jdbcType="BIGINT" property="createUser" />
        <id column="create_time" jdbcType="TIMESTAMP" property="createTime" />
        <id column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
        <id column="sum" jdbcType="DOUBLE" property="sum" />
    </resultMap>
<!--    SELECT t1.*,t2.id from orders t1 left join trad_account t2 on (JSON_CONTAINS(t1.commodity_list,concat(t2.id,''),"$") = 1) -->

    <sql id="base_sql" >
        id,CAST(commodity_list AS CHAR) as commodity_list,state,create_user,create_time,update_time,sum
    </sql>

    <insert id="insertSelective" parameterType="com.zsh.task.entity.Order">
        insert into orders
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="commodityList != null">
                commodity_list,
            </if>
            <if test="state != null">
                state,
            </if>
            <if test="createUser != null">
                create_user,
            </if>
            <if test="createTime != null">
                create_time,
            </if>
            <if test="updateTime != null">
                update_time,
            </if>
            <if test="sum != null">
                sum,
            </if>
        </trim>
            values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id,jdbcType=BIGINT},
            </if>
            <if test="commodityList != null">
                CAST(#{commodityList,jdbcType=VARCHAR} AS JSON),
            </if>
            <if test="state != null">
                #{state,jdbcType=VARCHAR},
            </if>
            <if test="createUser != null">
                #{createUser,jdbcType=TIMESTAMP},
            </if>
            <if test="update_time != null">
                #{update_time,jdbcType=TIMESTAMP},
            </if>
            <if test="sum != null">
                #{sum,jdbcType=DOUBLE},
            </if>

        </trim>
    </insert>

    <update id="updateSelective" parameterType="com.zsh.task.entity.Order">
        update orders
            <set>
                <if test="createTime != null">
                    create_time= #{createTime,jdbcType=TIMESTAMP},
                </if>
                <if test="updateTime != null">
                    update_time = #{updateTime,jdbcType=TIMESTAMP},
                </if>
                <if test="commodityList != null">
                    commodity_list = CAST(#{commodityList,jdbcType=VARCHAR} AS JSON),
                </if>
                <if test="state != null">
                    state = #{state,jdbcType=VARCHAR},
                </if>
                <if test="createUser != null">
                    create_user = #{createUser,jdbcType=TIMESTAMP},
                </if>
                <if test="sum != null">
                    sum = #{sum,jdbcType=DOUBLE},
                </if>
            </set>
        where id = #{id,jdbcType=BIGINT}
    </update>

</mapper>